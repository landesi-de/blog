---
import Layout from '../../layouts/Layout.astro';
import { formatDate, getBlog, getBlogs } from '../../lib/microcms';

export async function getStaticPaths() {
  const response = await getBlogs();
  return response.contents.map((post) => ({
    params: { id: post.id },
    props: { allPosts: response.contents },
  }));
}

const { id } = Astro.params;
const { allPosts } = Astro.props;
const post = await getBlog(id!);
const description = post.content.replace(/<[^>]*>/g, '').slice(0, 120);

const sortedPosts = [...allPosts].sort(
  (a, b) => new Date(b.publishedAt ?? 0).getTime() - new Date(a.publishedAt ?? 0).getTime(),
);
const currentIndex = sortedPosts.findIndex((item) => item.id === id);
const previousPost = currentIndex >= 0 ? sortedPosts[currentIndex + 1] : undefined;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;

// カテゴリ名の取り出し（配列でも単一文字列でも対応）
const categoryName = Array.isArray(post.category) ? post.category[0] : post.category;
---

<Layout title={`${post.title}`} description={description}>
  <article class="note-article">
    <nav class="article-nav" aria-label="記事ナビゲーション">
      {previousPost && (
        <a href={`/blog/${previousPost.id}`} class="previous-post" title={previousPost.title}>
          <span class="nav-label">« 前の記事</span>
          <span class="nav-title">{previousPost.title}</span>
        </a>
      )}
      {nextPost && (
        <a href={`/blog/${nextPost.id}`} class="next-post" title={nextPost.title}>
          <span class="nav-title">{nextPost.title}</span>
          <span class="nav-label">次の記事 »</span>
        </a>
      )}
    </nav>

    <header class="note-header">
      <div class="note-meta">
        <time datetime={post.publishedAt} class="note-date">{formatDate(post.publishedAt)}</time>
        {categoryName && (
          <a href={`/category/${encodeURIComponent(categoryName)}`} class="note-category">
            {categoryName}
          </a>
        )}
      </div>
      <h1 class="note-title">{post.title}</h1>
    </header>

    <div class="note-body" set:html={post.content} />

    <nav class="article-nav article-nav-bottom" aria-label="記事ナビゲーション">
      {previousPost && (
        <a href={`/blog/${previousPost.id}`} class="previous-post" title={previousPost.title}>
          <span class="nav-label">« 前の記事</span>
          <span class="nav-title">{previousPost.title}</span>
        </a>
      )}
      {nextPost && (
        <a href={`/blog/${nextPost.id}`} class="next-post" title={nextPost.title}>
          <span class="nav-title">{nextPost.title}</span>
          <span class="nav-label">次の記事 »</span>
        </a>
      )}
    </nav>

    <footer class="note-footer">
      <a class="back-link" href="/">← 記事一覧へ戻る</a>
    </footer>
  </article>
</Layout>

<style>
  .note-article {
    max-width: 880px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    font-family: "Zen Maru Gothic", sans-serif;
  }

  .note-header {
    margin-bottom: 3rem;
  }

  .article-nav {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.5rem;
  }

  .article-nav-bottom {
    margin-top: 3rem;
    margin-bottom: 0;
  }

  .article-nav a {
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    gap: 0.5rem;
    align-items: baseline;
    color: #1e3a8a;
    text-decoration: none;
  }

  .article-nav .next-post {
    justify-content: flex-end;
    text-align: right;
  }

  .article-nav .nav-label {
    flex: 0 0 auto;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .article-nav .nav-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.9rem;
  }

  .article-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .note-date {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .note-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e3a8a;
    background-color: #eff6ff;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .note-category:hover {
    background-color: #dbeafe;
  }

  .note-title {
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.4;
    color: #0f172a;
    letter-spacing: -0.01em;
    margin-bottom: 2rem;
  }

  .note-cover img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
  }

  .note-body {
    font-size: 1.05rem;
    line-height: 1.6;
    color: #27272a;
    letter-spacing: 0.025em;
  }

  .note-body :global(p) {
    margin: 0 0 0.55rem;
    line-height: 1.6;
    text-indent: 1em;
  }

  .note-body :global(h2) {
    font-family: "Zen Maru Gothic", sans-serif;
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.45;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    color: #0f172a;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid #1e3a8a;
  }

  .note-body :global(h3) {
    font-family: "Zen Maru Gothic", sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.45;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #1e293b;
  }

  .note-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 2.5rem auto;
    display: block;
  }

  .note-body :global(ul), .note-body :global(ol) {
    margin: 0.8rem 0 1rem;
    padding-left: 1.4rem;
    line-height: 1.7;
  }

  .note-body :global(li) {
    margin-bottom: 0.4rem;
  }

  .note-body :global(li:last-child) {
    margin-bottom: 0;
  }

  .note-body :global(blockquote) {
    margin: 2rem 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid #94a3b8;
    color: #64748b;
    font-style: italic;
  }

  .note-body :global(a) {
    color: #1e3a8a;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .note-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid #f1f5f9;
  }

  .back-link {
    font-size: 0.9rem;
    color: #1e3a8a;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>