---
interface Props {
  title: string;
  description?: string;
  heroImage?: string;
  heroAlt?: string;
}

const {
  title,
  description = '日々の記録と便利なモノ紹介',
  heroImage,
  heroAlt = '',
} = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;700&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} | NOTE & LIFE` : 'NOTE & LIFE'}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    {heroImage && (
      <div class="hero-banner" data-hero-banner>
        <img src={heroImage} alt={heroAlt} width="1920" height="360" />
      </div>
    )}
    <Header />
    <main class="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* サイト全体のリセットとフォント一括指定 */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ↓ ここのフォント指定がサイト全体の全ページ・全要素に一括適用されます */
  html,
  body,
  button,
  input,
  textarea,
  select {
    font-family: "Zen Maru Gothic", sans-serif;
    font-weight: 400;
    color: #27272a;
    background-color: #ffffff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h2,
  h3 {
    font-weight: 700;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .main-content {
    flex: 1;
  }

  .hero-banner {
    --hero-height: clamp(64px, 21vw, 240px);
    height: var(--hero-height);
    overflow: hidden;
    background: #e8ece3;
    transition: height 0.12s linear;
  }

  .hero-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  a {
    color: inherit;
  }

  img {
    max-width: 100%;
    height: auto;
  }
</style>

{heroImage && (
  <script>
    const heroBanner = document.querySelector<HTMLElement>('[data-hero-banner]');

    if (heroBanner) {
      const initialHeight = heroBanner.getBoundingClientRect().height;
      const minimumHeight = 64;
      let frameRequested = false;

      const updateHeroHeight = () => {
        const nextHeight = Math.max(minimumHeight, initialHeight - window.scrollY * 0.45);
        heroBanner.style.setProperty('--hero-height', `${nextHeight}px`);
        frameRequested = false;
      };

      window.addEventListener('scroll', () => {
        if (!frameRequested) {
          window.requestAnimationFrame(updateHeroHeight);
          frameRequested = true;
        }
      }, { passive: true });
    }
  </script>
)}