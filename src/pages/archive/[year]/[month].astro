---
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getBlogs } from '../../../lib/microcms';

export async function getStaticPaths() {
  const response = await getBlogs();
  const posts = response.contents;

  const monthMap = new Map<string, number>();

  posts.forEach((post) => {
    const published = post.publishedAt ? new Date(post.publishedAt) : null;
    if (!published || Number.isNaN(published.getTime())) return;

    const year = published.getFullYear();
    const month = published.getMonth() + 1;
    const key = `${year}/${month}`;
    monthMap.set(key, (monthMap.get(key) ?? 0) + 1);
  });

  return [...monthMap.entries()].map(([key]) => {
    const [year, month] = key.split('/').map(Number);
    return {
      params: { year: String(year), month: String(month) },
    };
  });
}

const { year, month } = Astro.params;
const response = await getBlogs();
const posts = response.contents.filter((post) => {
  const published = post.publishedAt ? new Date(post.publishedAt) : null;
  if (!published || Number.isNaN(published.getTime())) return false;
  return published.getFullYear() === Number(year) && published.getMonth() + 1 === Number(month);
});
const archiveLabel = `${Number(year)}年${Number(month)}月`;
---

<Layout title={`${archiveLabel} の記事一覧`}>
  <div class="note-container">
    <header class="archive-header">
      <span class="archive-tag">ARCHIVE</span>
      <h1 class="archive-title">{archiveLabel}</h1>
      <p class="archive-count">{posts.length} 件の記事</p>
    </header>

    <div class="post-list">
      {posts.length === 0 ? (
        <p class="empty-message">この月の記事はまだありません。</p>
      ) : (
        posts.map((post) => (
          <PostCard post={post} showMeta={true} showCategory={true} />
        ))
      )}
    </div>

    <footer class="archive-footer">
      <a class="back-link" href="/">← 記事一覧へ戻る</a>
    </footer>
  </div>
</Layout>

<style>
  .note-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    font-family: "Zen Maru Gothic", sans-serif;
  }

  .archive-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #0f172a;
  }

  .archive-tag {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #1e3a8a;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .archive-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.4rem;
  }

  .archive-count {
    font-size: 0.85rem;
    color: #64748b;
  }

  .empty-message {
    color: #94a3b8;
    padding: 3rem 0;
    text-align: center;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .archive-footer {
    margin-top: 3.5rem;
  }

  .back-link {
    font-size: 0.9rem;
    color: #1e3a8a;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .archive-header {
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
    }
  }
</style>
