---
const currentYear = new Date().getFullYear();
const BLOG_TITLE = "NOTE & LIFE";

const CATEGORIES = [
  '家電・ガジェット',
  '暮らし・習慣',
  '子ども・家族',
  '趣味・お出かけ',
  '仕事',
  '日常',
  'その他',
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand-name">{BLOG_TITLE}</a>
      <p class="brand-desc">日々の暮らしの道具と記録。</p>
    </div>

    <nav class="footer-nav" aria-label="フッターナビゲーション">
      <div class="nav-group">
        <span class="nav-title">Menu</span>
        <ul class="nav-links">
          <li><a href="/">Articles</a></li>
          <li><a href="/about">About</a></li>
        </ul>
      </div>

      <div class="nav-group">
        <span class="nav-title">Categories</span>
        <ul class="nav-links category-links">
          {CATEGORIES.map((cat) => (
            <li>
              <a href={`/category/${encodeURIComponent(cat)}`}>{cat}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="bottom-inner">
      <small class="copyright">&copy; {currentYear} {BLOG_TITLE}. All rights reserved.</small>
      <a href="#" class="back-to-top">↑ ページ上部へ</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    background-color: #ffffff;
    border-top: 1px solid #e2e8f0;
    margin-top: auto;
    font-family: "Zen Maru Gothic", sans-serif;
  }

  .footer-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem 2.5rem;
    display: flex;
    justify-content: space-between;
    gap: 3rem;
  }

  .footer-brand {
    flex: 1;
    min-width: 200px;
  }

  .brand-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    text-decoration: none;
    letter-spacing: 0.04em;
    display: inline-block;
    margin-bottom: 0.5rem;
  }

  .brand-desc {
    font-size: 0.85rem;
    color: #64748b;
    line-height: 1.6;
    margin: 0;
  }

  .footer-nav {
    display: flex;
    gap: 2.5rem;
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .nav-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #1e3a8a;
    text-transform: uppercase;
  }

  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .category-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.45rem 1.2rem;
  }

  .nav-links a {
    font-size: 0.82rem;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .nav-links a:hover {
    color: #1e3a8a;
  }

  .footer-bottom {
    border-top: 1px solid #f1f5f9;
    padding: 1.25rem 0;
  }

  .bottom-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .copyright {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .back-to-top {
    font-size: 0.75rem;
    color: #64748b;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .back-to-top:hover {
    color: #1e3a8a;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 2rem;
      padding: 2.5rem 1.25rem 2rem;
    }

    .footer-nav {
      flex-direction: column;
      gap: 1.5rem;
    }

    .category-links {
      grid-template-columns: 1fr;
    }
  }
</style>