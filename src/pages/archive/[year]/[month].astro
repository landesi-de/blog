---
import Layout from '../../../layouts/Layout.astro';
import { formatDate, getBlogs } from '../../../lib/microcms';

export async function getStaticPaths() {
  const response = await getBlogs();
  const posts = response.contents;

  const monthMap = new Map<string, number>();

  posts.forEach((post) => {
    const published = post.publishedAt ? new Date(post.publishedAt) : null;
    if (!published || Number.isNaN(published.getTime())) return;

    const year = published.getFullYear();
    const month = published.getMonth() + 1;
    const key = `${year}/${month}`;
    monthMap.set(key, (monthMap.get(key) ?? 0) + 1);
  });

  return [...monthMap.entries()].map(([key]) => {
    const [year, month] = key.split('/').map(Number);
    return {
      params: { year: String(year), month: String(month) },
    };
  });
}

const { year, month } = Astro.params;
const response = await getBlogs();
const posts = response.contents.filter((post) => {
  const published = post.publishedAt ? new Date(post.publishedAt) : null;
  if (!published || Number.isNaN(published.getTime())) return false;
  return published.getFullYear() === Number(year) && published.getMonth() + 1 === Number(month);
});
const archiveLabel = `${Number(year)}年${Number(month)}月`;
---

<Layout title={`${archiveLabel} の記事一覧`}>
  <div class="note-container">
    <header class="archive-header">
      <span class="archive-tag">ARCHIVE</span>
      <h1 class="archive-title">{archiveLabel}</h1>
      <p class="archive-count">{posts.length} 件の記事</p>
    </header>

    <div class="post-list">
      {posts.length === 0 ? (
        <p class="empty-message">この月の記事はまだありません。</p>
      ) : (
        posts.map((post) => {
          const excerpt = post.content.replace(/<[^>]*>/g, '').slice(0, 110);
          const categoryName = Array.isArray(post.category) ? post.category[0] : post.category;

          return (
            <article class="post-item">
              <a href={`/blog/${post.id}`} class="post-link">
                <div class="post-text">
                  <time datetime={post.publishedAt} class="post-date">{formatDate(post.publishedAt)}</time>
                  {categoryName && <span class="post-category">{categoryName}</span>}
                  <h2 class="post-title">{post.title}</h2>
                  <p class="post-excerpt">{excerpt}...</p>
                </div>
                {post.eyecatch && (
                  <div class="post-thumbnail">
                    <img
                      src={`${post.eyecatch.url}?w=400&h=260&fit=crop`}
                      alt={post.title}
                      width="180"
                      height="117"
                      loading="lazy"
                    />
                  </div>
                )}
              </a>
            </article>
          );
        })
      )}
    </div>

    <footer class="archive-footer">
      <a class="back-link" href="/">← 記事一覧へ戻る</a>
    </footer>
  </div>
</Layout>

<style>
  .note-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    font-family: "Zen Maru Gothic", sans-serif;
  }

  .archive-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #0f172a;
  }

  .archive-tag {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #1e3a8a;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .archive-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.4rem;
  }

  .archive-count {
    font-size: 0.85rem;
    color: #64748b;
  }

  .empty-message {
    color: #94a3b8;
    padding: 3rem 0;
    text-align: center;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-item {
    border-bottom: 1px solid #f1f5f9;
    padding: 2rem 0;
  }

  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    text-decoration: none;
  }

  .post-text {
    flex: 1;
    min-width: 0;
  }

  .post-date {
    display: block;
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 0.4rem;
  }

  .post-category {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    color: #1e3a8a;
    background-color: #eff6ff;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.55rem;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.5;
    color: #2d2a26;
    margin-bottom: 0.6rem;
    transition: color 0.15s ease;
  }

  .post-link:hover .post-title {
    color: #2d2a26;
  }

  .post-excerpt {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #64748b;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-thumbnail img {
    width: 160px;
    height: 104px;
    object-fit: cover;
    border-radius: 6px;
    display: block;
    background-color: #f1f5f9;
  }

  .archive-footer {
    margin-top: 3.5rem;
  }

  .back-link {
    font-size: 0.9rem;
    color: #1e3a8a;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .post-link {
      flex-direction: column-reverse;
      gap: 1rem;
    }

    .post-thumbnail img {
      width: 100%;
      height: 180px;
    }
  }
</style>
