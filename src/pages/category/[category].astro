---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getBlogs } from '../../lib/microcms';

export async function getStaticPaths() {
  const CATEGORIES = [
    '家電・ガジェット',
    '暮らし・習慣',
    '子ども・家族',
    '趣味・お出かけ',
    '仕事',
    '日常',
    'その他',
  ];

  const response = await getBlogs();
  const allPosts = response.contents;

  return CATEGORIES.map((cat) => {
    // カテゴリが一致する記事だけを抽出
    const filteredPosts = allPosts.filter((post) => {
      if (Array.isArray(post.category)) {
        return post.category.includes(cat);
      }
      return post.category === cat;
    });

    return {
      params: { category: cat },
      props: { posts: filteredPosts, currentCategory: cat },
    };
  });
}

const { posts, currentCategory } = Astro.props;
---

<Layout title={`${currentCategory} の記事一覧`}>
  <div class="note-container">
    <header class="category-header">
      <span class="category-tag">CATEGORY</span>
      <h1 class="category-title">{currentCategory}</h1>
      <p class="category-count">{posts.length} 件の記事</p>
    </header>

    <div class="post-list">
      {posts.length === 0 ? (
        <p class="empty-message">このカテゴリの記事はまだありません。</p>
      ) : (
        posts.map((post) => (
          <PostCard post={post} showMeta={true} showCategory={false} />
        ))
      )}
    </div>

    <footer class="category-footer">
      <a class="back-link" href="/">← 記事一覧へ戻る</a>
    </footer>
  </div>
</Layout>

<style>
  .note-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 5rem;
    font-family: "Zen Maru Gothic", sans-serif;
  }

  .category-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #0f172a;
  }

  .category-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #1e3a8a;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .category-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.4rem;
  }

  .category-count {
    font-size: 0.85rem;
    color: #64748b;
  }

  .empty-message {
    color: #94a3b8;
    padding: 3rem 0;
    text-align: center;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .category-footer {
    margin-top: 3.5rem;
  }

  .back-link {
    font-size: 0.9rem;
    color: #1e3a8a;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .category-header {
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
    }
  }
</style>