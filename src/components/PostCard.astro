---
import { formatDate } from '../lib/microcms';

interface Post {
  id: string;
  title: string;
  content: string;
  publishedAt?: string;
  category?: string | string[];
  eyecatch?: {
    url: string;
    width?: number;
    height?: number;
  };
}

interface Props {
  post: Post;
  showMeta?: boolean;
  showCategory?: boolean;
}

const { post, showMeta = true, showCategory = true } = Astro.props as Props;
const excerpt = post.content.replace(/<[^>]*>/g, '').slice(0, 110);
const categoryName = Array.isArray(post.category) ? post.category[0] : post.category;
---

<article class="post-item">
  {showMeta && (
    <div class="post-meta">
      <time datetime={post.publishedAt} class="post-date">
        {formatDate(post.publishedAt)}
      </time>
      {showCategory && categoryName && (
        <a href={`/category/${encodeURIComponent(categoryName)}`} class="post-category">
          {categoryName}
        </a>
      )}
    </div>
  )}

  <a href={`/blog/${post.id}`} class="post-link">
    <div class="post-text">
      <h2 class="post-title">{post.title}</h2>
      <p class="post-excerpt">{excerpt}...</p>
    </div>
    {post.eyecatch && (
      <div class="post-thumbnail">
        <img
          src={`${post.eyecatch.url}?w=400&h=260&fit=crop`}
          alt={post.title}
          width="180"
          height="117"
          loading="lazy"
        />
      </div>
    )}
  </a>
</article>

<style>
  .post-item {
    border-bottom: 1px solid #f1f5f9;
    padding: 2rem 0;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }

  .post-date {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .post-category {
    font-size: 0.72rem;
    font-weight: 600;
    color: #1e3a8a;
    background-color: #eff6ff;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .post-category:hover {
    background-color: #dbeafe;
  }

  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    text-decoration: none;
  }

  .post-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 6px;
  }

  .post-title {
    display: inline-block;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.5;
    color: #2d2a26 !important;
    margin: 0;
    letter-spacing: -0.01em;
    border-bottom: 2px solid transparent;
    transition: border-color 0.3s ease;
  }

  .post-link:hover .post-title {
    border-bottom-color: #2d2a26;
  }

  .post-excerpt {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #64748b;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-thumbnail {
    flex-shrink: 0;
  }

  .post-thumbnail img {
    width: 160px;
    height: 104px;
    object-fit: cover;
    border-radius: 6px;
    display: block;
    background-color: #f1f5f9;
  }

  @media (max-width: 768px) {
    .post-link {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    .post-text {
      flex: 1;
      min-width: 0;
    }

    .post-thumbnail {
      flex-shrink: 0;
    }

    .post-thumbnail img {
      width: 90px;
      height: 90px;
      object-fit: cover;
      border-radius: 8px;
    }
  }

  @media (max-width: 640px) {
    .post-link {
      flex-direction: row;
      gap: 0.9rem;
    }

    .post-thumbnail img {
      width: 84px;
      height: 84px;
      object-fit: cover;
      border-radius: 8px;
    }
  }
</style>
